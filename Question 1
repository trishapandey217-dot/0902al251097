#include <stdio.h>

int main() {
    int n, i;
    int arr[] = {1, 2, 4, 5, 6};

    n = 6;   // Numbers are from 1 to 6

    int expectedSum = n * (n + 1) / 2;
    int actualSum = 0;

    for (i = 0; i < n - 1; i++) {
        actualSum = actualSum + arr[i];
    }

    int missing = expectedSum - actualSum;

    printf("Missing number = %d", missing);

    return 0;
}
